<Page x:Class="_246_Windows.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_246_Windows.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CatalogPage">

    
        <StackPanel>
        <TextBlock Text="Каталог"  FontSize="18" HorizontalAlignment="Center"/>
        <ListBox  x:Name="listBooks" DisplayMemberPath="Title" Height="150"
                  SelectionChanged="listBooks_SelectionChanged"
                  MouseDoubleClick="listBooks_MouseDoubleClick"/>
        
        <TextBox Text="{Binding Title}" Margin="5"/>
        <TextBox Text="{Binding Author}" Margin="5"/>
        <TextBox Text="{Binding Year}" Margin="5"/>
            
        <Button Content="Удалить" x:Name="Del" Margin="15"/>

        <Button Content="Добавить" Margin="15" Click="add_Click"/>
        </StackPanel>

</Page>
